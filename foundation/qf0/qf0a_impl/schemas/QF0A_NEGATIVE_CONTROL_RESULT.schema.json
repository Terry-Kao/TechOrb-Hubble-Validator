{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "QF0A_NEGATIVE_CONTROL_RESULT.schema.json",
  "title": "QF-0A Negative Control Results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "protocol_file_sha256", "all_frozen_controls_present", "controls"],
  "properties": {
    "schema_version": {"const": "1.1"}, "run_id": {"$ref": "#/$defs/runId"},
    "protocol_file_sha256": {"const": "1cf9f7f3a8cfa6a5b0e12a3290d7e545f44586f9359aaa5367754415cdcc5f3a"},
    "all_frozen_controls_present": {"const": true},
    "controls": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "protocol_section", "expected_failure_mode", "observed_status", "expected_failure_observed", "post_hoc_mutation", "evidence_path", "evidence_sha256", "timestamp_utc", "reason_code"],
        "properties": {
          "control_id": {"enum": ["BROKEN_CONSTRAINT", "PRODUCT_NO_HISTORY", "WRONG_CONDITIONING", "HIDDEN_EXTERNAL_TIME", "CLOCK_SCRAMBLE", "POST_HOC_THRESHOLD_MUTATION"]},
          "protocol_section": {"const": "12"},
          "expected_failure_mode": {"type": "string", "minLength": 1},
          "observed_status": {"enum": ["PASS", "FAIL", "BLOCKED", "INVALIDATED"]},
          "expected_failure_observed": {"type": "boolean"},
          "post_hoc_mutation": {"const": false},
          "evidence_path": {"$ref": "#/$defs/relativePath"},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "timestamp_utc": {"type": "string", "format": "date-time"},
          "reason_code": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "notes": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "runId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!//)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}
  }
}
