{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "QF0A_MACHINE_VERDICT.schema.json",
  "title": "QF-0A Machine Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "protocol_file_sha256", "pipeline_reproduction_verdict", "foundation_model_verdict", "reason_codes", "required_evidence_complete", "negative_controls_complete", "leakage_audit_verdict"],
  "properties": {
    "schema_version": {"const": "1.1"}, "run_id": {"$ref": "#/$defs/runId"},
    "protocol_file_sha256": {"const": "1cf9f7f3a8cfa6a5b0e12a3290d7e545f44586f9359aaa5367754415cdcc5f3a"},
    "pipeline_reproduction_verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "INVALIDATED"]},
    "foundation_model_verdict": {"enum": ["NOT_APPLICABLE", "NOT_ESTABLISHED"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_-]+$"}},
    "required_evidence_complete": {"type": "boolean"}, "negative_controls_complete": {"type": "boolean"},
    "leakage_audit_verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "INVALIDATED"]}
  },
  "$defs": {"runId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"}},
  "allOf": [
    {"if": {"properties": {"pipeline_reproduction_verdict": {"const": "PASS"}}, "required": ["pipeline_reproduction_verdict"]}, "then": {"properties": {"required_evidence_complete": {"const": true}, "negative_controls_complete": {"const": true}, "leakage_audit_verdict": {"const": "PASS"}}}}
  ]
}
