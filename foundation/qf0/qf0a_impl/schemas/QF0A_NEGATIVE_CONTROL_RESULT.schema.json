{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "QF0A_NEGATIVE_CONTROL_RESULT.schema.json",
  "title": "QF-0A Negative Control Results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "protocol_file_sha256", "all_frozen_controls_present", "controls"],
  "properties": {
    "schema_version": {"const": "1.0"}, "run_id": {"type": "string", "minLength": 1},
    "protocol_file_sha256": {"const": "fb7969c11e9e2d4b1eebdd2495692dc422eca418bbbaa85bbabcda2815811d8b"},
    "all_frozen_controls_present": {"type": "boolean"},
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "protocol_section", "expected_failure_mode", "observed_status", "expected_failure_observed", "post_hoc_mutation", "evidence_sha256"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "protocol_section": {"type": "string"},
          "expected_failure_mode": {"type": "string", "minLength": 1},
          "observed_status": {"enum": ["PASS", "FAIL", "BLOCKED", "INVALIDATED"]},
          "expected_failure_observed": {"type": "boolean"},
          "post_hoc_mutation": {"const": false},
          "evidence_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
